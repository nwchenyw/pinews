@{
    ViewData["Title"] = "聯絡我們";
}

<div class="ui container" style="margin-top: 30px;">
    <h2 class="ui header">
        <i class="envelope icon"></i>
        <div class="content">
            聯絡我們
            <div class="sub header">有任何問題或建議，歡迎與我們聯繫</div>
        </div>
    </h2>

    <div class="ui grid">
        <div class="ten wide column">
            <form class="ui form" method="post" asp-action="Index">
                @Html.AntiForgeryToken()
                <div class="ui segment">
                    @if (ViewData["Error"] != null)
                    {
                        <div class="ui negative message">
                            <p>@ViewData["Error"]</p>
                        </div>
                    }
                    @if (ViewData["Success"] != null)
                    {
                        <div class="ui positive message">
                            <p>@ViewData["Success"]</p>
                        </div>
                    }

                    <div class="field">
                        <label>姓名</label>
                        <input type="text" name="name" placeholder="請輸入您的姓名" required>
                    </div>
                    <div class="field">
                        <label>電子郵件</label>
                        <input type="email" name="email" placeholder="請輸入您的電子郵件" required>
                    </div>
                    <div class="field">
                        <label>主旨</label>
                        <input type="text" name="subject" placeholder="請輸入主旨" required>
                    </div>
                    <div class="field">
                        <label>訊息內容</label>
                        <textarea name="message" rows="5" placeholder="請輸入您的訊息" required></textarea>
                    </div>
                    <button class="ui blue button" type="submit">送出</button>
                </div>
            </form>
        </div>

        <div class="six wide column">
            <div class="ui segment">
                <h3 class="ui header">聯絡資訊</h3>
                <div class="ui list">
                    <div class="item">
                        <i class="envelope icon"></i>
                        <div class="content">
                            ask.pinews@gmail.com
                        </div>
                    </div>
                    <div class="item">
                        <i class="map marker icon"></i>
                        <div class="content">
                            台灣
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
