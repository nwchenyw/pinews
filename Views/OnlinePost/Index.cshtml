@{
    ViewData["Title"] = "線上投稿";
}

<div class="ui container" style="margin-top: 30px;">
    <h2 class="ui header">
        <i class="edit icon"></i>
        <div class="content">
            線上投稿
            <div class="sub header">分享您的新聞與故事</div>
        </div>
    </h2>

    <form class="ui form" method="post" asp-action="Index">
        @Html.AntiForgeryToken()
        <div class="ui segment">
            @if (ViewData["Error"] != null)
            {
                <div class="ui negative message">
                    <p>@ViewData["Error"]</p>
                </div>
            }
            @if (ViewData["Success"] != null)
            {
                <div class="ui positive message">
                    <p>@ViewData["Success"]</p>
                </div>
            }

            <div class="field">
                <label>標題</label>
                <input type="text" name="Title" placeholder="請輸入文章標題" required>
            </div>
            
            <div class="field">
                <label>作者</label>
                <input type="text" name="Author" placeholder="請輸入作者名稱" required>
            </div>

            <div class="field">
                <label>內容</label>
                <textarea name="Content" rows="15" placeholder="請輸入文章內容" required></textarea>
            </div>

            <div class="field">
                <label>封面圖片網址（選填）</label>
                <input type="text" name="Image" placeholder="請輸入圖片網址">
            </div>

            <button class="ui blue button" type="submit">送出文章</button>
            <a href="/Member" class="ui button">取消</a>
        </div>
    </form>
</div>
