@using Microsoft.AspNetCore.Mvc.RazorPages
<!doctype html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PiNews</title>
    <!-- Primary CSS: Semantic UI (from local if available) and Bootstrap fallback -->
    <link rel="stylesheet" href="/semantic/dist/semantic.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <header class="site-header bg-white border-bottom">
        <div class="container d-flex align-items-center justify-content-between py-2">
            <div class="d-flex align-items-center">
                <a class="navbar-brand me-3" href="/">
                    <img src="/images/logo.svg" alt="PiNews" style="height:48px;" />
                </a>
                <div class="site-slogan">
                    <h1 class="h5 mb-0">全民創報，百業創聞，萬眾創利。</h1>
                </div>
            </div>
            <div class="d-flex align-items-center">
                <a class="me-3" href="/Login">網記登入/註冊</a>
                <a class="me-3" href="/ContactUs">聯絡我們</a>
            </div>
        </div>
        <nav class="main-nav border-top">
            <div class="container">
                <div class="ui secondary pointing menu" style="margin:0;">
                    <a class="item" href="/">首頁</a>
                    <a class="item" href="/News/1">拍新聞</a>
                    <a class="item" href="/News/2">拍國際</a>
                    <a class="item" href="/News/3">拍兩岸</a>
                    <a class="item" href="/News/24">拍教育</a>
                    <a class="item" href="/News/4">拍財經</a>
                    <a class="item" href="/News/11">拍企業</a>
                    <a class="item" href="/News/5">拍公益</a>
                    <a class="item" href="/News/6">拍人物</a>
                    <a class="item" href="/News/7">拍生活</a>
                    <a class="item" href="/News/8">拍旅行</a>
                    <a class="item" href="/News/9">拍美食</a>
                </div>
            </div>
        </nav>
    </header>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <footer class="site-footer bg-light border-top mt-5 py-4">
        <div class="container text-center small">&copy; PiNews</div>
    </footer>

    <!-- Scripts: jQuery (for Semantic UI), Semantic, Bootstrap, site script -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/semantic/dist/semantic.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js"></script>
</body>
</html>
