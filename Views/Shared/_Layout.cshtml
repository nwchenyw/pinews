<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - 拍新聞</title>
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@100;300;400;500;700;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="~/semantic/dist/semantic.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@splidejs/splide@@latest/dist/css/splide.min.css">
    <link rel="stylesheet" href="~/css/main.css">
    <link rel="stylesheet" href="~/css/animation.css">
</head>
<body>
    <!-- Top Bar -->
    <div class="ui yellow inverted basic segment">
        <div class="ui horizontal divided list">
            <div class="item">
                <div class="content">
                    <a href="/Member"><i class="user friends icon"></i>會員中心</a>
                </div>
            </div>
            <div class="item">
                <div class="content">
                    <a href="/Account/Logout"><i class="door open icon"></i>登出</a>
                </div>
            </div>
            <div class="item">
                <div class="content">
                    <a href="/Account/Login"><i class="user friends icon"></i>會員登入</a>
                </div>
            </div>
            <div class="item">
                <div class="content">
                    <a href="/ContactUs"><i class="envelope icon"></i>聯絡我們</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Sidebar Menu -->
    <div class="ui top demo vertical inverted sidebar labeled icon blue menu">
        <a class="item" href="/News/Category/1">拍新聞</a>
        <a class="item" href="/News/Category/2">拍國際</a>
        <a class="item" href="/News/Category/3">拍兩岸</a>
        <a class="item" href="/News/Category/4">拍財經</a>
        <a class="item" href="/News/Category/5">拍公益</a>
        <a class="item" href="/News/Category/6">拍人物</a>
        <a class="item" href="/News/Category/7">拍生活</a>
        <a class="item" href="/News/Category/8">拍旅行</a>
        <a class="item" href="/News/Category/9">拍美食</a>
        <a class="item" href="/OnlinePost">線上投稿</a>
    </div>

    <!-- Logo and Main Menu -->
    <div class="ui container">
        <div class="ui medium image">
            <a href="/"><img src="~/img/PiNewsGIF2.gif" alt="拍新聞"></a>
        </div>
        <div id="main-menu" class="ui blue inverted pointing sticky menu">
            <a class="horizontal item" href="/News/Category/1">拍新聞</a>
            <a class="horizontal item" href="/News/Category/2">拍國際</a>
            <a class="horizontal item" href="/News/Category/3">拍兩岸</a>
            <a class="horizontal item" href="/News/Category/24">拍教育</a>
            <a class="horizontal item" href="/News/Category/4">拍財經</a>
            <a class="horizontal item" href="/News/Category/11">拍企業</a>
            <a class="horizontal item" href="/News/Category/5">拍公益</a>
            <a class="horizontal item" href="/News/Category/6">拍人物</a>
            <a class="horizontal item" href="/News/Category/7">拍生活</a>
            <a class="horizontal item" href="/News/Category/8">拍旅行</a>
            <a class="horizontal item" href="/News/Category/9">拍美食</a>
            <a class="horizontal item" href="/OnlinePost">線上投稿</a>
            <div class="right menu">
                <div class="item">
                    <div id="search" class="ui transparent icon inverted">
                        <input type="text" class="hidden" placeholder="Search...">
                        <i class="search link icon" style="margin: 3.5px 0;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    @RenderBody()

    <!-- Footer -->
    <div class="ui inverted vertical footer segment">
        <div class="ui container">
            <div class="ui stackable inverted divided equal height stackable grid">
                <div class="three wide column">
                    <h4 class="ui inverted header">關於</h4>
                    <div class="ui inverted link list">
                        <a href="#" class="item">關於我們</a>
                        <a href="/ContactUs" class="item">聯絡我們</a>
                    </div>
                </div>
                <div class="seven wide column">
                    <h4 class="ui inverted header">拍新聞</h4>
                    <p>全民創報，百業創聞，萬眾創利。</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/semantic/dist/semantic.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@splidejs/splide@@latest/dist/js/splide.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
